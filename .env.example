# ==============================================================================
# Upstash Redis Configuration (Free Cloud Database)
# 1. Sign up for free at https://console.upstash.com
# 2. Click "Create Database" (select free tier)
# 3. Under "REST API", copy UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN
# ==============================================================================

UPSTASH_REDIS_REST_URL=https://your-upstash-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# (Optional) Set a password to protect publishing if your studio is public
# ADMIN_SECRET=your_secret_passkey_here
